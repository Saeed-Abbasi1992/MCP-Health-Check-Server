{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "SessionCleanup": {
    "CleanupIntervalSeconds": 45,
    "SessionTimeoutMinutes": 6
  },
  "UrlPolicy": {
    "AllowedDomains": [
      "example.com",
      "api.mycompany.com"
    ]
  },
  "AllowedHosts": "*"
}
